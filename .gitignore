# Dependencies
node_modules/
.pnpm-store/

# pnpm-only repo — disallow npm/yarn lockfiles (preinstall guard also blocks them,
# but tools like `ionic start` will still scribble a package-lock.json on scaffold)
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Wrangler local state and build output; local Worker secrets
.wrangler/
.dev.vars*

# Angular / Ionic
.angular/
.ionic/
www/

# Generated
packages/client/src/environments/version.ts

# Capacitor native shells (generated; iOS/Android added later)
# ios/App/build/
# android/app/build/

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude Code per-user settings (not committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/.state/

# Code review receipts — local cache of "this commit was reviewed", keyed by
# sha. The review itself lives on the PR.
.review-receipts/

# Node.js compile cache (runtime artefact, not source)
node-compile-cache/

# Screenshot scope hint — per-author, per-feature; read by
# scripts/screenshot-publish.mjs as a Playwright --grep regex.
.screenshot-tags

# graphify knowledge-graph build artefacts
# Per graphify README: graphify-out/ is meant to be committed so everyone on the
# team starts with a map. These entries exclude per-machine state only.
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
