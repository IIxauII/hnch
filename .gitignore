# Dependencies
node_modules/
.pnpm-store/

# pnpm-only repo — disallow npm/yarn lockfiles (preinstall guard also blocks them,
# but tools like `ionic start` will still scribble a package-lock.json on scaffold)
package-lock.json
yarn.lock

# Build output
dist/
build/
*.tsbuildinfo

# Wrangler local state and build output; local Worker secrets
.wrangler/
.dev.vars*

# Angular / Ionic
.angular/
.ionic/
www/

# Generated
packages/client/src/environments/version.ts

# Capacitor native shells (generated; iOS/Android added later)
# ios/App/build/
# android/app/build/

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude Code per-user settings (not committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Code review receipts — local cache of "this commit was reviewed", keyed by
# sha. The review itself lives on the PR.
.review-receipts/

# Node.js compile cache (runtime artefact, not source)
node-compile-cache/

# Screenshot scope hint — per-author, per-feature; read by
# scripts/screenshot-publish.mjs as a Playwright --grep regex.
.screenshot-tags

# graphify knowledge graph: rebuilt locally whenever the graphify skill runs,
# and stale as soon as main moves, so it is not committed.
graphify-out/

# Per-developer MCP server config for Claude Code
.mcp.json

# Screenshot captures: local/ from runs without SCREENSHOT_SHA, sha-<short>/
# from the pre-push hook and CI. Nothing here is tracked since #597: every
# published set lives on the `screenshots` branch (main's reference under
# latest/ there), see docs/release.md › Screenshots.
docs/screenshots/
