{
  "name": "hnch",
  "version": "0.0.0",
  "private": true,
  "description": "Planning poker app. See project.md and adr/ for design.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev:client": "pnpm --filter @hnch/client dev",
    "dev:relay": "pnpm --filter @hnch/relay dev",
    "dev:cli": "pnpm --filter @hnch/cli dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:e2e": "pnpm --filter @hnch/e2e test"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
