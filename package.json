{
  "name": "hnch",
  "version": "0.0.0",
  "private": true,
  "description": "Planning poker app. See docs/project.md and adr/ for design.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev:client": "bash scripts/with-env.sh pnpm --filter @hnch/client dev",
    "dev:relay": "bash scripts/with-env.sh pnpm --filter @hnch/relay dev",
    "dev:cli": "bash scripts/with-env.sh pnpm --filter @xauyxau/hnch dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:e2e": "bash scripts/with-env.sh pnpm --filter @hnch/e2e test",
    "worktree:add": "node scripts/worktree-add.mjs",
    "worktree:remove": "node scripts/worktree-remove.mjs",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "audit:versions": "node scripts/audit-versions.mjs",
    "release:dry": "for p in shared relay client cli; do pnpm exec semantic-release --extends ./packages/$p/.releaserc.json --dry-run --no-ci || exit 1; done"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "^12.0.0",
    "semantic-release": "25.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
