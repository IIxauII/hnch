{
  "name": "@xauyxau/hnch",
  "version": "1.6.0",
  "description": "Pointing poker CLI for agile teams",
  "keywords": [
    "pointing-poker",
    "planning-poker",
    "agile",
    "cli",
    "estimation"
  ],
  "license": "UNLICENSED",
  "author": "xau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IIxauII/hnch.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/IIxauII/hnch#readme",
  "bugs": {
    "url": "https://github.com/IIxauII/hnch/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hnch": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "biome format .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yargs": "^17.7.2",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@hnch/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.1.1"
  }
}
