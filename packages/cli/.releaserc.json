{
  "extends": "../../.releaserc.base.json",
  "tagFormat": "cli-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "feat", "release": false },
          { "type": "fix", "release": false },
          { "type": "perf", "release": false },
          { "breaking": true, "release": false },
          { "scope": "cli", "type": "feat", "release": "minor" },
          { "scope": "cli", "type": "fix", "release": "patch" },
          { "scope": "cli", "type": "perf", "release": "patch" },
          { "scope": "cli", "breaking": true, "release": "major" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      { "npmPublish": false, "pkgRoot": "packages/cli" }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "packages/cli/CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "echo 'TODO(deploy): publish cli ${nextRelease.version} - npm registry vs binary TBD'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["packages/cli/package.json", "packages/cli/CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.gitTag} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
