{
  "extends": "../../.releaserc.base.json",
  "tagFormat": "relay-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "scope": "relay", "type": "feat", "release": "minor" },
          { "scope": "relay", "type": "fix", "release": "patch" },
          { "scope": "relay", "type": "perf", "release": "patch" },
          { "scope": "relay", "breaking": true, "release": "major" },
          { "scope": "*", "release": false }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      { "npmPublish": false, "pkgRoot": "packages/relay" }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "packages/relay/CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["packages/relay/package.json", "packages/relay/CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.gitTag} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
