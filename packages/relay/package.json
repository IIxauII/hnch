{
  "name": "@hnch/relay",
  "version": "1.4.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./testing": {
      "types": "./testing/start-relay.d.mts",
      "default": "./testing/start-relay.mjs"
    }
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "biome format .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@hnch/shared": "workspace:*",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-istanbul": "4.1.12",
    "typescript": "^5.5.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.3",
    "ws": "^8.22.0"
  }
}
