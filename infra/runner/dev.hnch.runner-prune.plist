<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.hnch.runner-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/xau/.local/bin/hnch-runner-prune.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's default PATH lacks Homebrew. podman + pnpm live at /opt/homebrew/bin. -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/xau/Library/Logs/hnch-runner-prune.out.log</string>
  <key>StandardErrorPath</key><string>/Users/xau/Library/Logs/hnch-runner-prune.err.log</string>
</dict>
</plist>
