{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run format:check *)",
      "Bash(pnpm --filter @hnch/shared typecheck *)",
      "Bash(pnpm --filter @hnch/shared test *)",
      "Bash(pnpm --filter @hnch/shared lint *)",
      "Bash(pnpm --filter @hnch/shared build *)",
      "Bash(pnpm --filter @hnch/shared format:check *)",
      "Bash(pnpm --filter @hnch/relay typecheck *)",
      "Bash(pnpm --filter @hnch/relay test *)",
      "Bash(pnpm --filter @hnch/relay lint *)",
      "Bash(pnpm --filter @hnch/relay build *)",
      "Bash(pnpm --filter @hnch/relay format:check *)",
      "Bash(pnpm --filter @hnch/client typecheck *)",
      "Bash(pnpm --filter @hnch/client test *)",
      "Bash(pnpm --filter @hnch/client lint *)",
      "Bash(pnpm --filter @hnch/client build *)",
      "Bash(pnpm --filter @hnch/client format:check *)",
      "Bash(pnpm --filter @xauyxau/hnch typecheck *)",
      "Bash(pnpm --filter @xauyxau/hnch test *)",
      "Bash(pnpm --filter @xauyxau/hnch lint *)",
      "Bash(pnpm --filter @xauyxau/hnch build *)",
      "Bash(pnpm --filter @xauyxau/hnch format:check *)",
      "Bash(pnpm --filter @hnch/e2e typecheck *)",
      "Bash(pnpm --filter @hnch/e2e lint *)",
      "Bash(pnpm --filter @hnch/e2e format:check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune)",
      "Bash(git fetch origin --prune)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)"
    ],
    "ask": [
      "Bash(rg *--pre*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/block-coauthor-commit.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/warn-force-push.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/enforce-pnpm.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/protect-accepted-adrs.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/stop-notify.sh" },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/session-start-context.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh --seed"
          }
        ]
      }
    ]
  }
}
